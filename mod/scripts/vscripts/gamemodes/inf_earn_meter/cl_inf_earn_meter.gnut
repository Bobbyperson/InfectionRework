global function Cl_InfectionEarnMeter_Init
global function Cl_InfectionEarnMeter_UpdateInfectionHealth

const float FILL_ANIM_DURATION = 0.2

struct EarnChangeData {
    float startValue = 0.0
    float endValue = 0.0
    float updateTime = 0.0
}

struct {
    EarnChangeData lastEarnedData
    var earnMeterRui
} file

void function Cl_InfectionEarnMeter_Init( entity player )
{
    file.earnMeterRui = CreateCockpitRui( $"ui/earn_meter.rpak" )
    
    RuiSetFloat( file.earnMeterRui, "fillAnimDuration", FILL_ANIM_DURATION )
    RuiSetGameTime( file.earnMeterRui, "lastEarnChangeTime", RUI_BADGAMETIME )
    RuiSetFloat( file.earnMeterRui, "earnedStartFrac", 0.0 )
    RuiSetInt( file.earnMeterRui, "meterMode", 5 )
    
    thread Cl_InfectionEarnMeter_UpdateInfectionHealth()
}

void function Cl_InfectionEarnMeter_UpdateInfectionHealth()
{
    while ( IsValid( file.earnMeterRui ) )
    {
        if ( GAMETYPE == INFECTION )
        {
            int myTeam = player.GetTeam();
            int enemyTeam = GetEnemyTeam(myTeam);
            IntFromEntityCompare compareFunc = GetScoreboardCompareFunc();
            float maxInfectedHealth = 0.0;
            
            array<entity> allPlayers = GetSortedPlayers( compareFunc, 0 );
            array<entity> enemyTeamPlayers = GetSortedPlayers( compareFunc, enemyTeam );
            int playerCount = allPlayers.len();
            int enemyTeamCount = enemyTeamPlayers.len();
            maxInfectedHealth = ( 1 - ( enemyTeamCount.tofloat() / playerCount.tofloat() ) ) * 200;
            
            
            float frac = maxInfectedHealth / 200;
            RuiSetFloat( file.earnMeterRui, "earnedFrac", frac );
            RuiSetFloat( file.earnMeterRui, "ownedFrac", frac );
        }
        WaitFrame();
    }
}